// ** SETUP **
// (Script) gets attached to the Main Camera
// Create Empty > PARENT GameObject for Player and Main Camera (as child)
// Main Camera : Transform : Position => X: 0, Y: 1.7, Z: 0     (for PlayerObject Y: 1.8)
// Attach (Script) to Main Camera

using UnityEngine;

[RequireComponent(typeof(Transform))]
public class HeadRotateCamera : MonoBehaviour
{
    // - Components -
    [SerializeField] private Transform playerTx;                // this player object

    [Header("USer Input Control Variables")]
    [Tooltip("Disable if sending inputs from an external script")]
    public bool useLocalInputs = true;
    [Space(5)]
    [HideInInspector] public string axisLookHorzizontal = "Mouse X";          // Mouse to Look
    [HideInInspector] public string axisLookVertical = "Mouse Y";             //
    [HideInInspector] public KeyCode keyToggleCursor = KeyCode.Escape;        // Esc to toggle lock cursor)

    // Input Variables that can be assigned externally
    // the cursor can also be manually locked or freed by calling the public void SetLockCursor( bool doLock )
    [HideInInspector] public float inputLookX = 0.0f;               //
    [HideInInspector] public float inputLookY = 0.0f;               //
    [HideInInspector] public bool inputKeyDownCursor = false;       // is key Pressed

    [Header("Mouse Look Control Variables")]
    [SerializeField, Range(1f, 10f)] private float m_sensitivityModifier = 2.646f;
    private float clampLookY = 89.5f;                // maximum look up/down angle

    [Header("Supporting Reference Variables")]
    private float m_headYaw = 0.0f;                  // the side-to-side movement angle the player is looking
    private float m_headPitch = 0.0f;                // the up/down angle the player is looking
    [Space(5)]
    [HideInInspector] public bool cursorActive = false;                // cursor state


    // Life cycle method. Start()
    private void Start()
    {
        Initialize();

        //Disable cursor
        Cursor.lockState = CursorLockMode.Locked;
    }

    // Life cycle method. Update()
    private void Update()
    {
        ProcessInputs();
        ProcessLook();
    }

    #region Refactored Methods Region
    private void Initialize()
    {
        if (playerTx == null)
        {
            Debug.LogWarning("* Main Camera has NOT been assigned a BasicFPCC Transform object *");
            playerTx = transform;
        }

        RefreshCursor();
    }

    private void ProcessInputs()
    {
        if (useLocalInputs)
        {
            inputLookX = Input.GetAxis(axisLookHorzizontal);
            inputLookY = Input.GetAxis(axisLookVertical);

            inputKeyDownCursor = Input.GetKeyDown(keyToggleCursor);
        }

        if (inputKeyDownCursor)
        {
            ToggleLockCursor();
        }
    }

    // ** ORIGINAL code without Mouse Smoothing
    private void ProcessLook()
    {
        // rotate camera off the Y-axis
        m_headYaw += m_sensitivityModifier * inputLookX;

        // rotate camera off the X-axis
        m_headPitch -= m_sensitivityModifier * inputLookY;
        m_headPitch = Mathf.Clamp(m_headPitch, -clampLookY, clampLookY);

        // apply this rotation. Quaternion is also responsible for rotation
        transform.localRotation = Quaternion.Euler(m_headPitch, m_headYaw, 0.0f);
    }

    // lock/hide or show/unlock cursor
    public void SetLockCursor(bool doLock)
    {
        cursorActive = doLock;
        RefreshCursor();
    }

    private void ToggleLockCursor()
    {
        cursorActive = !cursorActive;
    }

    private void RefreshCursor()
    {
        if (inputKeyDownCursor)
        {
            //Enable cursor
            if (cursorActive && Cursor.lockState != CursorLockMode.None)
            { Cursor.lockState = CursorLockMode.Confined; }
        }
        else if (!inputKeyDownCursor)
        {
            //Disable cursor
            if (!cursorActive && Cursor.lockState != CursorLockMode.Locked) { Cursor.lockState = CursorLockMode.Locked; }
        }
    }
    #endregion
    //---
}

