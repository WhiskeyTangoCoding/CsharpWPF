** UPDATED code with Mouse Smoothing

    [Header("Mouse Look Control Variables")]

    [Tooltip("larger values for less filtering, more responsiveness")]
    //private const float m_mouseSnappiness = 20.4f;     // default was 10f; larger values of this cause less filtering, more responsiveness
    //private const float m_percentageConst = 100.0f;
    //private bool invertLookY = false;                // toggle invert look Y


    [Header("Supporting Reference Variables")]
    private float accMouseX = 0.0f;                  // reference for mouse look smoothing
    private float accMouseY = 0.0f;                  // reference for mouse look smoothing
// <stop>


    private void ProcessLook()
    {
        // ProcessLook code with Mouse Smoothing
        accMouseX = Mathf.Lerp(accMouseX, inputLookX, m_mouseSnappiness * Time.deltaTime);
        accMouseY = Mathf.Lerp(accMouseY, inputLookY, m_mouseSnappiness * Time.deltaTime);

        float mouseX = accMouseX * m_speedModifier * m_percentageConst * Time.deltaTime;
        float mouseY = accMouseY * m_speedModifier * m_percentageConst * Time.deltaTime;

        // rotate camera off the Y-axis
        m_headYaw += mouseX;

        // rotate camera off the X-axis
        m_headPitch += (invertLookY == true ? mouseY : -mouseY);
        m_headPitch = Mathf.Clamp(m_headPitch, -clampLookY, clampLookY);

        // apply this rotation. Quaternion is also responsible for rotation
        transform.localRotation = Quaternion.Euler(m_headPitch, m_headYaw, 0.0f);
    }

